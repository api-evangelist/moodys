        {
          "name": "token",
          "item": [
            {
              "name": "Moody's Obtain an Access Token",
              "id": "036140fa-941e-4aed-be4f-68510518c4af",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) The OAuth2 grant type. Must be client_credentials.",
                      "key": "grant_type",
                      "value": "client_credentials"
                    },
                    {
                      "description": "(Required) The API client ID issued by Moody's Analytics.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The API client secret issued by Moody's Analytics.",
                      "key": "client_secret",
                      "value": "<string>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/oauth2/token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "oauth2",
                    "token"
                  ]
                },
                "description": "Authenticates using OAuth2 client credentials and returns a bearer access token for subsequent API requests."
