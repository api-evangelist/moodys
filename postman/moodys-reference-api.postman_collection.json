{
  "info": {
    "_postman_id": "98a22669-a7f8-4ce5-a998-aedcd68b0951",
    "name": "Moody's Data Buffet Baskets Reference API",
    "description": "The Moody's Analytics Data Buffet API provides programmatic access to international and subnational economic, demographic, and financial time series data and forecasts. It enables retrieval of individual series or baskets of data, supports frequency conversion, mathematical transformations, date range filtering, and vintage/versioning selection. Code samples are available in C#, Java, Python, and R.\n\nContact Support:\n Name: Moody's Analytics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:15:28.000Z",
    "updatedAt": "2026-07-28T02:15:28.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-98a22669-a7f8-4ce5-a998-aedcd68b0951"
  },
