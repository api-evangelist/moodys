            "body": {
              "mode": "raw",
              "raw": "{\n  \"series\": [\n    {\n      \"mnemonic\": \"<string>\",\n      \"freq\": \"W\",\n      \"trans\": \"AnnualizedGrowth\",\n      \"startDate\": \"<date>\",\n      \"endDate\": \"<date>\",\n      \"vintage\": \"<date>\"\n    },\n    {\n      \"mnemonic\": \"<string>\",\n      \"freq\": \"D\",\n      \"trans\": \"YearOverYearPercentChange\",\n      \"startDate\": \"<date>\",\n      \"endDate\": \"<date>\",\n      \"vintage\": \"<date>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
